package main

import (
	"encoding/json"
	"net/http"
	"os"
	"runtime"
	"time"
)

var startedAt = time.Now()

type memoryMetrics struct {
	RSSBytes      *uint64 `json:"rssBytes,omitempty"`
	HeapUsedBytes uint64  `json:"heapUsedBytes,omitempty"`
	HeapTotalBytes uint64 `json:"heapTotalBytes,omitempty"`
}

type cpuMetrics struct {
	Percent float64 `json:"percent"`
}

type processMetrics struct {
	PID     int          `json:"pid"`
	RSSBytes *uint64     `json:"rssBytes,omitempty"`
	CPU     *cpuMetrics  `json:"cpu,omitempty"`
}

type metricsPayload struct {
	Status    string           `json:"status"`
	UpdatedAt string           `json:"updatedAt"`
	PID       int              `json:"pid"`
	UptimeSec int64            `json:"uptimeSec"`
	Memory    memoryMetrics    `json:"memory"`
	CPU       cpuMetrics       `json:"cpu"`
	Processes []processMetrics `json:"processes"`
}

func buildMetrics() metricsPayload {
	var mem runtime.MemStats
	runtime.ReadMemStats(&mem)

	return metricsPayload{
		Status:    "running",
		UpdatedAt: time.Now().UTC().Format(time.RFC3339Nano),
		PID:       os.Getpid(),
		UptimeSec: int64(time.Since(startedAt).Seconds()),
		Memory: memoryMetrics{
			HeapUsedBytes: mem.Alloc,
			HeapTotalBytes: mem.HeapSys,
		},
		CPU: cpuMetrics{
			Percent: 0,
		},
		Processes: []processMetrics{
			{
				PID: os.Getpid(),
				CPU: &cpuMetrics{Percent: 0},
			},
		},
	}
}

func main() {
	port := os.Getenv("PORT")
	if port == "" {
		port = "0"
	}

	mux := http.NewServeMux()
	mux.HandleFunc("/control-panel/metrics", func(w http.ResponseWriter, r *http.Request) {
		if r.Method != http.MethodGet {
			w.Header().Set("Content-Type", "text/plain; charset=utf-8")
			w.WriteHeader(http.StatusMethodNotAllowed)
			_, _ = w.Write([]byte("Method not allowed"))
			return
		}

		payload, err := json.Marshal(buildMetrics())
		if err != nil {
			w.Header().Set("Content-Type", "text/plain; charset=utf-8")
			w.WriteHeader(http.StatusInternalServerError)
			_, _ = w.Write([]byte("Failed to serialize metrics"))
			return
		}

		w.Header().Set("Content-Type", "application/json; charset=utf-8")
		_, _ = w.Write(payload)
	})

	_ = http.ListenAndServe("127.0.0.1:"+port, mux)
}
