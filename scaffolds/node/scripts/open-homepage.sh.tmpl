#!/usr/bin/env bash
set -euo pipefail

surface_type="{{surfaceType}}"

if [ -n "{{frontendUrl}}" ] && [ "$surface_type" != "desktop" ] && [ "$surface_type" != "service" ]; then
  open "{{frontendUrl}}"
  exit 0
fi

if [ -n "{{appLaunchCommand}}" ] && [ "$surface_type" != "web" ]; then
  cd "{{workingDirectory}}"
  exec {{appLaunchCommand}}
fi

if [ -n "{{appUrl}}" ] && [ "$surface_type" != "web" ]; then
  open "{{appUrl}}"
  exit 0
fi

if [ -n "{{homepageUrl}}" ]; then
  open "{{homepageUrl}}"
  exit 0
fi

echo "No project entry configured" >&2
exit 1
