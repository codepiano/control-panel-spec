use chrono::{SecondsFormat, Utc};
use serde::Serialize;
use std::io::{Read, Write};
use std::net::TcpListener;
use std::process;
use std::time::Instant;

static STARTED_AT: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();

#[derive(Serialize)]
#[serde(rename_all = "camelCase")]
struct MemoryMetrics {
    #[serde(skip_serializing_if = "Option::is_none")]
    rss_bytes: Option<u64>,
    #[serde(skip_serializing_if = "Option::is_none")]
    heap_used_bytes: Option<u64>,
    #[serde(skip_serializing_if = "Option::is_none")]
    heap_total_bytes: Option<u64>,
}

#[derive(Serialize)]
#[serde(rename_all = "camelCase")]
struct CpuMetrics {
    #[serde(skip_serializing_if = "Option::is_none")]
    percent: Option<f64>,
}

#[derive(Serialize)]
#[serde(rename_all = "camelCase")]
struct ProcessMetrics {
    pid: i32,
    #[serde(skip_serializing_if = "Option::is_none")]
    rss_bytes: Option<u64>,
    #[serde(skip_serializing_if = "Option::is_none")]
    cpu: Option<CpuMetrics>,
}

#[derive(Serialize)]
#[serde(rename_all = "camelCase")]
struct MetricsPayload {
    status: &'static str,
    updated_at: String,
    pid: i32,
    uptime_sec: u64,
    memory: MemoryMetrics,
    cpu: CpuMetrics,
    processes: Vec<ProcessMetrics>,
}

fn metrics() -> MetricsPayload {
    let started = STARTED_AT.get_or_init(Instant::now);

    MetricsPayload {
        status: "running",
        updated_at: Utc::now().to_rfc3339_opts(SecondsFormat::Millis, true),
        pid: process::id() as i32,
        uptime_sec: started.elapsed().as_secs(),
        memory: MemoryMetrics {
            rss_bytes: None,
            heap_used_bytes: None,
            heap_total_bytes: None,
        },
        cpu: CpuMetrics {
            percent: Some(0.0),
        },
        processes: vec![ProcessMetrics {
            pid: process::id() as i32,
            rss_bytes: None,
            cpu: Some(CpuMetrics {
                percent: Some(0.0),
            }),
        }],
    }
}

fn handle_connection(mut stream: std::net::TcpStream) {
    let mut buf = [0_u8; 1024];
    let _ = stream.read(&mut buf);
    let request = String::from_utf8_lossy(&buf);
    let is_metrics = request.starts_with("GET /control-panel/metrics ");

    if is_metrics {
        if let Ok(body) = serde_json::to_string(&metrics()) {
            let response = format!(
                "HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\nContent-Length: {}\r\n\r\n{}",
                body.len(),
                body
            );
            let _ = stream.write_all(response.as_bytes());
            return;
        }
    }

    let body = "Not found";
    let response = format!(
        "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: {}\r\n\r\n{}",
        body.len(),
        body
    );
    let _ = stream.write_all(response.as_bytes());
}

fn main() {
    let port = std::env::var("PORT").unwrap_or_else(|_| "0".to_string());
    let listener = TcpListener::bind(format!("127.0.0.1:{port}")).expect("bind metrics port");

    for stream in listener.incoming() {
        if let Ok(stream) = stream {
            handle_connection(stream);
        }
    }
}
